<%-- Settings popup (season theme picker).
     Included by every page that has the gear button (#btn-settings):
         <%@ include file="/WEB-INF/jspf/settings-dialog.jspf" %>
     Put it inside <main class="app-screen">, just before </main>.
     Behaviour lives in js/theme.js. --%>
<div id="settings-dialog" class="sheet-backdrop" hidden>

    <div class="sheet"
         role="dialog"
         aria-modal="true"
         aria-labelledby="settings-title">

        <div class="sheet-handle"></div>

        <h2 class="sheet-title" id="settings-title">Settings</h2>

        <div class="sheet-form">

            <div class="setting-block">

                <strong id="season-heading">Season theme</strong>

                <div class="season-grid"
                     role="radiogroup"
                     aria-labelledby="season-heading">

                    <label class="season-opt">
                        <input type="radio" name="season" value="auto">
                        <span class="season-card"><i class="swatch auto"></i>Auto</span>
                    </label>

                    <label class="season-opt">
                        <input type="radio" name="season" value="spring">
                        <span class="season-card"><i class="swatch spring"></i>Spring</span>
                    </label>

                    <label class="season-opt">
                        <input type="radio" name="season" value="summer">
                        <span class="season-card"><i class="swatch summer"></i>Summer</span>
                    </label>

                    <label class="season-opt">
                        <input type="radio" name="season" value="fall">
                        <span class="season-card"><i class="swatch fall"></i>Fall</span>
                    </label>

                    <label class="season-opt">
                        <input type="radio" name="season" value="winter">
                        <span class="season-card"><i class="swatch winter"></i>Winter</span>
                    </label>

                </div>

                <p class="muted season-caption" id="season-caption"></p>

            </div>

            <button type="button" class="btn btn-block" id="close-settings">Close</button>

        </div>
    </div>
</div>
